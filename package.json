{
  "name": "ezpage-frontend",
  "version": "1.0.0",
  "description": "一個讓用戶上傳HTML檔案並自動部署到GitHub Pages的服務",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:github": "npm run build && gh-pages -d dist",
    "firebase:deploy": "firebase deploy --only functions,firestore"
  },
  "dependencies": {
    "vue": "^3.3.8",
    "@vueuse/core": "^10.5.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.4.1",
    "vite": "^4.5.0",
    "tailwindcss": "^3.3.6",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "gh-pages": "^6.1.0"
  },
  "type": "module"
}